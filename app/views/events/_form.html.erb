<% if event.errors.any? %>
  <div role="alert" class="form-errors">
    <h2>Please correct the following:</h2>

    <ul>
      <% event.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: event,
              class: "form",
              data: { turbo: false } do |form| %>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title,
                        required: true,
                        placeholder: "e.g. Spring Concert",
                        data: { preview_target: "title", action: "input->preview#update" } %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description,
                       rows: 5,
                       placeholder: "What should attendees know? Line-up, agenda, dress code…",
                       data: { preview_target: "description", action: "input->preview#update" } %>
  </div>

  <div class="field-grid">
    <div class="field">
      <%= form.label :venue %>
      <%= form.text_field :venue,
                          required: true,
                          placeholder: "e.g. Rudder Auditorium",
                          data: { preview_target: "venue", action: "input->preview#update" } %>
    </div>

    <div class="field">
      <%= form.label :starts_at, "Starts at" %>
      <%= form.datetime_local_field :starts_at,
                                    required: true,
                                    data: { controller: "datetime", preview_target: "startsAt", action: "input->preview#update" } %>
    </div>
  </div>

  <div class="field">
    <%= form.label :total_capacity, "Total capacity" %>
    <%= form.number_field :total_capacity,
                          required: true,
                          min: 1,
                          step: 1,
                          placeholder: "100",
                          data: { preview_target: "capacity", action: "input->preview#update" } %>
    <p class="field__hint">The combined capacity of all ticket tiers can't exceed this number.</p>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", (event.persisted? ? event_path(event) : events_path), class: "btn btn--ghost" %>
  </div>
<% end %>
