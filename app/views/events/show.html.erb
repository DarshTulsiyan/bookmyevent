<h1><%= @event.title %></h1>

<% if current_user == @event.organizer || current_user&.admin? %>
  <p>Status: <%= event_status_badge(@event) %></p>
<% end %>

<% if @event.pending? && current_user&.admin? %>
  <p>
    <%= button_tag "Approve & publish",
                   type: "button",
                   disabled: true,
                   class: "admin-review-button",
                   title: "Approval actions will be implemented later" %>
    <%= button_tag "Reject",
                   type: "button",
                   disabled: true,
                   class: "admin-review-button admin-review-button--reject",
                   title: "Rejection actions will be implemented later" %>
  </p>
  <p>Review controls are shown for reference; approval and rejection are not available yet.</p>
<% end %>

<p>When: <%= l @event.starts_at, format: :long %></p>
<p>Where: <%= @event.venue %></p>

<% if @event.description.present? %>
  <%= simple_format @event.description %>
<% end %>

<% if current_user == @event.organizer %>
  <p><%= link_to "Edit event", edit_event_path(@event) %></p>
<% end %>

<section aria-labelledby="ticket-tiers-heading">
  <h2 id="ticket-tiers-heading">Tickets</h2>

  <% if @ticket_tiers.any? %>
    <table>
      <thead>
        <tr>
          <th scope="col">Tier</th>
          <th scope="col">Seats left</th>
        </tr>
      </thead>
      <tbody>
        <% @ticket_tiers.each do |tier| %>
          <tr>
            <td><%= tier.name %></td>
            <td><%= tier.seats_left.positive? ? tier.seats_left : "Sold out" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <% if current_user == @event.organizer %>
      <p>You have not configured ticket tiers for this event yet.</p>
    <% elsif current_user&.admin? %>
      <p>No ticket tiers have been configured for this event.</p>
    <% else %>
      <p>Tickets are not on sale yet.</p>
    <% end %>
  <% end %>
</section>

<p><%= link_to "Back to events", events_path %></p>
