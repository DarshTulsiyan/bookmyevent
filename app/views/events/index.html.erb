<% content_for :title, "Upcoming events | BookMyEvent" %>
<% total_seats_left = @events.sum(&:seats_left) %>

<section class="hero" aria-labelledby="events-heading">
  <div>
    <span class="eyebrow"><%= icon(:sparkles, size: 14) %> Discover &middot; Book &middot; Attend</span>
    <h1 id="events-heading">Upcoming events</h1>
    <p class="hero__lead">Concerts, talks, workshops and meetups happening around you. Find something you love and lock in your seats in seconds.</p>
  </div>
  <div class="hero__stats" aria-label="Event highlights">
    <div class="hero__stat">
      <strong><%= @events.size %></strong>
      <span><%= @events.size == 1 ? "event on sale" : "events on sale" %></span>
    </div>
    <div class="hero__stat">
      <strong><%= number_with_delimiter(total_seats_left) %></strong>
      <span>seats still open</span>
    </div>
  </div>
</section>

<% if @events.any? %>
  <div data-controller="event-filter">
    <div class="events-toolbar">
      <label class="input-icon">
        <span class="sr-only">Search events</span>
        <%= icon(:search) %>
        <input type="search"
               class="input-plain"
               placeholder="Search by title or venue…"
               autocomplete="off"
               data-event-filter-target="query"
               data-action="input->event-filter#apply">
      </label>

      <label>
        <span class="sr-only">Sort events</span>
        <select class="input-plain" data-event-filter-target="sort" data-action="change->event-filter#apply">
          <option value="date">Soonest first</option>
          <option value="seats">Most seats left</option>
          <option value="title">Title A–Z</option>
        </select>
      </label>

      <div class="segmented" role="group" aria-label="Layout">
        <button type="button" aria-pressed="true" data-view="grid" data-event-filter-target="viewButton" data-action="event-filter#setView" aria-label="Grid view"><%= icon(:grid, size: 16) %></button>
        <button type="button" aria-pressed="false" data-view="list" data-event-filter-target="viewButton" data-action="event-filter#setView" aria-label="List view"><%= icon(:list, size: 16) %></button>
      </div>

      <span class="result-count" aria-live="polite" data-event-filter-target="count">
        <%= pluralize(@events.size, "event") %>
      </span>
    </div>

    <ul class="event-grid" data-view="grid" data-event-filter-target="list">
      <% @events.each do |event| %>
        <% stats = tier_stats(event.ticket_tiers) %>
        <li class="event-card"
            style="--hue: <%= event_hue(event) %>"
            data-event-filter-target="card"
            data-title="<%= event.title.downcase %>"
            data-venue="<%= event.venue.downcase %>"
            data-starts="<%= event.starts_at.to_i %>"
            data-seats="<%= stats[:left] %>">
          <div class="event-card__media">
            <%= event_date_tile(event) %>
            <%= availability_chip(stats[:left], stats[:capacity]) %>
          </div>

          <div class="event-card__body">
            <h2 class="event-card__title"><%= link_to event.title, event_path(event), class: "stretched-link" %></h2>
            <p class="event-card__meta"><%= icon(:calendar, size: 15) %> Date: <%= l event.starts_at, format: :long %></p>
            <p class="event-card__meta"><%= icon(:pin, size: 15) %> Venue: <%= event.venue %></p>

            <div class="event-card__footer">
              <p class="event-card__seats">
                <span>Seats left: <%= event.seats_left %></span>
                <% if stats[:capacity].positive? %>
                  <span class="muted"><%= stats[:percent] %>% booked</span>
                <% end %>
              </p>
              <%= meter(stats[:percent], label: "#{event.title} booking progress") %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="empty-state" data-event-filter-target="empty" hidden>
      <div class="empty-state__icon"><%= icon(:search, size: 24) %></div>
      <h3>No events match your search</h3>
      <p>Try a different title or venue.</p>
    </div>
  </div>
<% else %>
  <div class="empty-state">
    <div class="empty-state__icon"><%= icon(:calendar, size: 24) %></div>
    <h2>Nothing on the calendar</h2>
    <p>No upcoming events yet. Check back soon.</p>
    <% if current_user&.organizer? %>
      <%= link_to new_event_path, class: "btn btn--primary" do %><%= icon(:plus, size: 16) %> Host the first event<% end %>
    <% end %>
  </div>
<% end %>
