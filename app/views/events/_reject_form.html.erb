<%= form_with url: reject_event_path(event),
              method: :patch,
              data: { turbo: false } do |form| %>
  <% reason_id = dom_id(event, :rejection_reason) %>
  <%= form.label :rejection_reason, "Rejection reason", for: reason_id %>
  <%= form.text_area :rejection_reason, id: reason_id, required: true %>
  <%= form.submit "Reject", class: "admin-review-button admin-review-button--reject" %>
<% end %>
