<tr>
  <td><%= tier.name %></td>
  <td><%= ticket_price_label(tier) %></td>
  <td>
    <%= tier.sold_out? ? "Sold Out" : tier.seats_left %>
    <%= meter(tier.capacity.to_i.positive? ? (tier.tickets_sold * 100.0 / tier.capacity) : 0,
              label: "#{tier.name} booking progress") %>
  </td>
  <td>
    <% if tier.sold_out? %>
      <span class="chip chip--danger">Sold Out</span>
    <% elsif current_user&.attendee? %>
      <%= form_with url: tickets_path, data: { turbo: false } do %>
        <%= hidden_field_tag :ticket_tier_id, tier.id %>
        <%= submit_tag "Book", class: "btn btn--soft btn--sm" %>
      <% end %>
    <% elsif current_user.nil? %>
      <%= link_to "Log in to book", login_path %>
    <% else %>
      <span class="muted small">Available to attendees</span>
    <% end %>
  </td>
</tr>
