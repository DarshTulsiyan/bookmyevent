<% content_for :title, "Events awaiting approval | Admin | BookMyEvent" %>

<header class="page-header">
  <div>
    <span class="eyebrow"><%= icon(:shield, size: 14) %> Admin</span>
    <h1>Events awaiting approval</h1>
    <p>Pending events are listed here for review.</p>
  </div>
</header>

<%= render "navigation" %>

<section class="card card--flush" aria-labelledby="pending-events-heading">
  <div class="card__head" style="padding: 1.25rem 1.25rem 0">
    <h2 id="pending-events-heading" class="card__title"><%= icon(:clock) %> Pending events</h2>
    <span class="chip"><%= pluralize(@events.size, "event") %></span>
  </div>
  <%= render "events_table",
             events: @events,
             caption: "Events awaiting approval",
             approval_actions: true,
             empty_message: "There are no events awaiting approval." %>
</section>
