<% content_for :title, "Rejected events | Admin | BookMyEvent" %>

<header class="page-header">
  <div>
    <span class="eyebrow"><%= icon(:shield, size: 14) %> Admin</span>
    <h1>Rejected events</h1>
    <p>Events that were rejected during review.</p>
  </div>
</header>

<%= render "navigation" %>

<section class="card card--flush" aria-labelledby="rejected-events-heading">
  <div class="card__head" style="padding: 1.25rem 1.25rem 0">
    <h2 id="rejected-events-heading" class="card__title"><%= icon(:ban) %> Rejected events</h2>
    <span class="chip"><%= pluralize(@events.size, "event") %></span>
  </div>
  <%= render "events_table",
             events: @events,
             caption: "Rejected events",
             approval_actions: false,
             empty_message: "There are no rejected events." %>
</section>
