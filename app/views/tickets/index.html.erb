<h1>My Tickets</h1>

<% if @bookings.empty? %>
  <p>You haven't booked any tickets yet.</p>
<% else %>
  <% @bookings.each do |booking| %>
    <section aria-labelledby="booking-<%= booking.id %>">
      <h2 id="booking-<%= booking.id %>">Booking #<%= booking.id %> — <%= booking.event.title %></h2>
      <p>When: <%= l booking.event.starts_at, format: :long %></p>
      <p>Where: <%= booking.event.venue %></p>
      <table>
        <thead><tr><th scope="col">Ticket ID</th><th scope="col">Tier</th></tr></thead>
        <tbody>
          <% booking.tickets.sort_by(&:id).each do |ticket| %>
            <tr><td><%= ticket.ticket_code %></td><td><%= ticket.ticket_tier.name %></td></tr>
          <% end %>
        </tbody>
      </table>
      <p><%= link_to "View event", event_path(booking.event) %></p>
    </section>
  <% end %>
<% end %>

<p><%= link_to "Browse events", events_path %></p>
